#!/usr/bin/env bash
# Refresh the opencode xAI OAuth token and republish it to GitHub repo secrets.
#
# Reference copy. This runs on the Pi, never on a dev box — two hosts rotating the
# same grant race each other and one of them ends up publishing a token the other
# already invalidated. Install with ops/wpa-oc-auth.{service,timer}.
#
# The Pi is the ONLY thing that ever calls refresh. Runners get a copy with the
# refresh token stripped, so a CI run cannot rotate the token out from under us.
# Driven by wpa-oc-auth.timer every 4h against a ~6h token, so the copy up there
# always has hours of life left and a runner never reaches the near-expiry skew.
#
# All machine-specific values come from /etc/wpa-oc.env (root-owned 0600, read by
# systemd before it drops to the service user, so that user never needs read access
# to the PAT). Never put any of them in this file:
#
#   GH_TOKEN=ghp_...                      # PAT with Secrets: read and write
#   WPA_OC_MODEL=xai/grok-4.6             # from `opencode models | grep -i grok`
#   WPA_OC_REPOS="owner/repo owner/other" # space separated, one /oc-enabled repo each
set -euo pipefail

AUTH="$HOME/.local/share/opencode/auth.json"
SECRET="OPENCODE_AUTH_JSON"

# systemd gets a minimal PATH; the curl installer drops opencode in ~/.opencode/bin.
export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"
command -v opencode >/dev/null || { echo "opencode not on PATH" >&2; exit 1; }
command -v gh >/dev/null || { echo "gh not on PATH" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq not on PATH" >&2; exit 1; }
[ -s "$AUTH" ] || { echo "no auth store at $AUTH — run 'opencode auth login'" >&2; exit 1; }
[ -n "${GH_TOKEN:-}" ] || { echo "GH_TOKEN unset — check /etc/wpa-oc.env" >&2; exit 1; }
[ -n "${WPA_OC_MODEL:-}" ] || { echo "WPA_OC_MODEL unset — check /etc/wpa-oc.env" >&2; exit 1; }
[ -n "${WPA_OC_REPOS:-}" ] || { echo "WPA_OC_REPOS unset — check /etc/wpa-oc.env" >&2; exit 1; }

read -ra REPOS <<< "$WPA_OC_REPOS"

# ponytail: there is no `opencode auth refresh`. Backdating expires makes opencode
# treat the grant as stale and refresh it on the next call, so rotation does not
# depend on whatever skew upstream uses. Replace if a real command lands.
# stdout is the model's reply and is noise; stderr is why a refresh failed, so it
# goes to the journal.
cp -p "$AUTH" "$AUTH.bak"
trap 'rm -f "$AUTH.bak"' EXIT
jq '.xai.expires = 0' "$AUTH.bak" > "$AUTH"
opencode run --dir "$HOME" -m "$WPA_OC_MODEL" ok >/dev/null || true

# Refuse to publish a dead token. A silent refresh failure should fail the timer
# now, not sit in the repo secret until the next /oc run dies on a 401.
now=$(date +%s%3N)
exp=$(jq -r '.xai.expires // 0' "$AUTH")
if (( exp <= now + 3600000 )); then
  echo "xai token expires in under 1h (exp=$exp, now=$now) — refresh did not take" >&2
  cp -p "$AUTH.bak" "$AUTH"   # put the working credential back for the next run
  exit 1
fi

runner_auth=$(jq -c 'map_values(del(.refresh))' "$AUTH")
[[ "$runner_auth" == *'"refresh"'* ]] && { echo "refresh token survived the strip — refusing to publish" >&2; exit 1; }

for repo in "${REPOS[@]}"; do
  printf '%s' "$runner_auth" | gh secret set "$SECRET" --repo "$repo"
  echo "pushed $SECRET -> $repo (valid until $(date -d "@$((exp/1000))" '+%F %T %Z'))"
done
